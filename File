{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "userHandles": {
      "$handle": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "posts": {
      ".read": "auth != null",
      ".indexOn": ["timestamp"],
      "$postId": {
        ".write": "auth != null"
      }
    },

    "stories": {
      ".read": "auth != null",
      ".indexOn": ["timestamp"],
      "$storyId": {
        ".write": "auth != null"
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },

    "typing": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "messages": {
      "$conversationId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["timestamp"]
      }
    }
  }
}
